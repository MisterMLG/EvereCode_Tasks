    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.2",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  }
