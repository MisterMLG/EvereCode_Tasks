# Server port
PORT=3000

# Bearer API key for protected endpoints (64-character hex string).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_TOKEN=

# Path to the SQLite database file (defaults to ./data/app.sqlite)
DATABASE_PATH=

# Timeout (ms) for outbound requests to external APIs
HTTP_TIMEOUT_MS=5000

# Retry policy for outbound requests (network errors, timeouts, 429, 5xx)
HTTP_RETRIES=2
HTTP_RETRY_DELAY_MS=300

# External API base URLs
BINANCE_BASE_URL=https://api.binance.com
BLOCKSTREAM_BASE_URL=https://blockstream.info/api
